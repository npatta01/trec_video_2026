FROM localhost/trec-vqa-gate-rocm:2026-07-20

# MiniCPM-o 4.5 explicitly requires Transformers 4.51.0. The ROCm base has
# newer PyTorch than its tested range; the gate records whether that works.
RUN python -m pip install --no-cache-dir \
    "transformers==4.51.0" \
    "minicpmo-utils==1.0.6"

# pkg_resources was removed from the newer setuptools in the ROCm base, but
# MiniCPM's custom audio code still imports it.
RUN python -m pip install --no-cache-dir "setuptools==80.9.0"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    NLTK_DATA=/opt/nltk_data

WORKDIR /workspace
