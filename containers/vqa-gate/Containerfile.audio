FROM docker.io/rocm/pytorch@sha256:4449f856653602317e4101a76fce599c7fcd58ccec2e539951fce5f73083179e

RUN python -m pip install --no-cache-dir \
    "accelerate==1.12.0" \
    "librosa==0.11.0" \
    "mistral-common[audio]==1.11.6" \
    "qwen-asr==0.0.6" \
    "soundfile==0.13.1" \
    "transformers==4.57.6"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HF_HUB_DISABLE_TELEMETRY=1

WORKDIR /workspace
